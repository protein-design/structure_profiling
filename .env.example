# MySQL connection used by structure_profiling.database.Db
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
# default database of the *Complex classes
MYSQL_DB=COMPLEX2

# verbose output of pipelines (true/false)
verbose=true

# data directories (pipelines write results below output_dir)
output_dir=/data/structure_profiling
# scratch directory for IO-heavy pipelines (defaults to output_dir)
tmp_dir=/tmp
# raw data shared with bio_omics (downloaded PDB/mmCIF files),
# used by the combo2..5 split pipelines via meta_pdb.relative_pdb
# (defaults to output_dir when unset)
rawdata_dir=/data/omics/rawdata

# predict pipelines (AlphaFold via colabfold, TM-align)
# bin dir of the colabfold conda env and the colabfold databases
colabfold_bin_dir=/path/to/colabfold/bin
colabfold_db=/path/to/colabfold_db
# TMalign binary dir used by af_tmalign
mmalign_dir=/path/to/TMalign
# predicted structures (defaults to output_dir/predict)
#predict_dir=/data/structure_profiling/predict
