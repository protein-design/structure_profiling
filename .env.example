# MySQL connection used by structure_profiling.database.Db
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
# default database of the *Complex classes
MYSQL_DB=COMPLEX2

# verbose output of pipelines (true/false)
verbose=true

# data directories (pipelines write results below output_dir)
output_dir=/data/structure_profiling
# scratch directory for IO-heavy pipelines (defaults to output_dir)
tmp_dir=/tmp
